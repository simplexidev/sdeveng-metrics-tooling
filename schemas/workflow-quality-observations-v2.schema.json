{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/simplexidev/sdeveng-metrics-tooling/develop/v3.0.0/schemas/workflow-quality-observations-v2.schema.json",
  "title": "Private run and commit scoped workflow-quality observations",
  "description": "Local validation and explicit repair evidence. Keep raw records private; publish only reviewed aggregates.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "localValidations", "repairCommits"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "localValidations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository", "commitSha", "attemptOrdinal", "check", "result"],
        "properties": {
          "repository": { "$ref": "#/$defs/repository" },
          "runId": { "$ref": "#/$defs/text" },
          "commitSha": { "$ref": "#/$defs/sha" },
          "attemptOrdinal": { "type": "integer", "minimum": 1 },
          "check": { "$ref": "#/$defs/text" },
          "result": { "enum": ["passed", "failed", "cancelled", "timedOut"] }
        }
      }
    },
    "repairCommits": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository", "beforeCommitSha", "repairCommitSha"],
        "properties": {
          "repository": { "$ref": "#/$defs/repository" },
          "runId": { "$ref": "#/$defs/text" },
          "beforeCommitSha": { "$ref": "#/$defs/sha" },
          "repairCommitSha": { "$ref": "#/$defs/sha" }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "sha": { "type": "string", "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" }
  }
}
