{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/simplexidev/sdeveng-metrics-tooling/develop/v3.0.0/schemas/workflow-quality-observations-v1.schema.json",
  "title": "Private deterministic workflow-quality observations",
  "description": "Tooling input evidence. Do not publish raw observations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "commitSha"],
      "properties": {
        "repository": { "$ref": "#/$defs/text" },
        "commitSha": { "$ref": "#/$defs/sha" },
        "stageId": { "$ref": "#/$defs/text" },
        "workUnitId": { "$ref": "#/$defs/text" }
      }
    },
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["observationId", "kind", "repository", "commitSha"],
      "properties": {
        "observationId": { "$ref": "#/$defs/text" },
        "kind": { "enum": ["workUnitValidation", "repairCommit", "hostedWorkflow", "verificationComparison", "finalPrRequiredChecks"] },
        "repository": { "$ref": "#/$defs/text" },
        "commitSha": { "$ref": "#/$defs/sha" },
        "stageId": { "$ref": "#/$defs/text" },
        "workUnitId": { "$ref": "#/$defs/text" },
        "attemptOrdinal": { "type": "integer", "minimum": 1 },
        "result": { "enum": ["passed", "failed", "cancelled", "timedOut"] },
        "repairCommitSha": { "$ref": "#/$defs/sha" },
        "repairObservationId": { "$ref": "#/$defs/text" },
        "provider": { "$ref": "#/$defs/text" },
        "providerRunId": { "$ref": "#/$defs/text" },
        "ciClass": { "enum": ["advisory", "final"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMilliseconds": { "type": "integer", "minimum": 0 },
        "localResult": { "enum": ["passed", "failed", "cancelled", "timedOut"] },
        "hostedResult": { "enum": ["passed", "failed", "cancelled", "timedOut"] },
        "pullRequestId": { "$ref": "#/$defs/text" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "workUnitValidation" } }, "required": ["kind"] }, "then": { "required": ["stageId", "workUnitId", "attemptOrdinal", "result"] } },
        { "if": { "properties": { "kind": { "const": "repairCommit" } }, "required": ["kind"] }, "then": { "required": ["stageId", "workUnitId", "repairCommitSha", "repairObservationId"] } },
        { "if": { "properties": { "kind": { "const": "hostedWorkflow" } }, "required": ["kind"] }, "then": { "required": ["provider", "providerRunId", "attemptOrdinal", "ciClass", "result", "startedAt", "completedAt", "durationMilliseconds"] } },
        { "if": { "properties": { "kind": { "const": "verificationComparison" } }, "required": ["kind"] }, "then": { "required": ["localResult", "hostedResult"] } },
        { "if": { "properties": { "kind": { "const": "finalPrRequiredChecks" } }, "required": ["kind"] }, "then": { "required": ["pullRequestId", "provider", "providerRunId", "attemptOrdinal", "result", "startedAt", "completedAt", "durationMilliseconds"], "properties": { "ciClass": { "const": "final" } } } }
      ]
    }
  }
}
