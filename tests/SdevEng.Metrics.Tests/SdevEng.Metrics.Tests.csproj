<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SdevEngProducerRoot Condition="'$(SdevEngProducerRoot)' == ''">$(MSBuildThisFileDirectory)../../../sdeveng</SdevEngProducerRoot>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="JsonSchema.Net" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SdevEng.Metrics/SdevEng.Metrics.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../scenarios/fixtures/token-context-v1/*" Link="TokenFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SdevEngProducerRoot)/schemas/rendered-input-token-measurement.schema.json" Link="Schemas/rendered-input-token-measurement.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SdevEngProducerRoot)/schemas/tokenizer-manifest.schema.json" Link="Schemas/tokenizer-manifest.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SdevEngProducerRoot)/schemas/chat-template-manifest.schema.json" Link="Schemas/chat-template-manifest.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(SdevEngProducerRoot)/schemas/prompt-manifest.schema.json" Link="Schemas/prompt-manifest.schema.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../schemas/**/*.json" Link="Schemas/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
